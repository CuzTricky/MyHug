        Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = text, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Dim, Font = Enum.Font.Gotham, TextSize = 11,
    }, parent)
end

