local function addToggle(parent, text, default, cb, key)
    local state = default and true or false
    local row = new("TextButton", {Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = Theme.Item, BorderSizePixel = 0, Text = "", AutoButtonColor = false}, parent)
    corner(row, 3)
    local box = new("Frame", {Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(5, 4), BackgroundColor3 = Theme.Bg, BorderSizePixel = 0}, row)
    corner(box, 3)
    local fill = new("Frame", {Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(3, 3), BorderSizePixel = 0, Visible = state}, box)
    accent(fill, "BackgroundColor3")
    corner(fill, 2)
    new("TextLabel", {
        Size = UDim2.new(1, -28, 1, 0), Position = UDim2.fromOffset(26, 0), BackgroundTransparency = 1,
        Text = text, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 12,
    }, row)
    local function setState(v)
        state = v and true or false
        fill.Visible = state
        if key then Flags[key] = state end
        task.spawn(cb, state)
    end
    conn(row.MouseButton1Click, function() setState(not state) end)
    if key then
        Flags[key], Defaults[key] = state, state
        Setters[key] = setState
    end
    if state then task.spawn(cb, state) end
end

local function addSlider(parent, text, min, max, default, step, suffix, cb, key)
    local frame = new("Frame", {Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Theme.Item, BorderSizePixel = 0}, parent)
    corner(frame, 3)
    local label = new("TextLabel", {
        Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(6, 1), BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 12, Text = "",
    }, frame)
    local bar = new("Frame", {Size = UDim2.new(1, -12, 0, 6), Position = UDim2.fromOffset(6, 22), BackgroundColor3 = Theme.Bg, BorderSizePixel = 0}, frame)
    corner(bar, 3)
    local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0}, bar)
    accent(fill, "BackgroundColor3")
    corner(fill, 3)

    local function set(v)
        v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
        fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
        label.Text = text .. ": " .. tostring(v) .. (suffix or "")
        if key then Flags[key] = v end
        cb(v)
    end
    set(default)
    if key then
        Defaults[key] = default
        Setters[key] = set
    end

    local dragging = false
    local function fromInput(x)
        set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
    end
    conn(bar.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromInput(i.Position.X)
        end
    end)
    conn(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            fromInput(i.Position.X)
        end
    end)
    conn(UIS.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

