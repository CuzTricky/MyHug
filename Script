local Theme = {
    Bg = Color3.fromRGB(22, 22, 26),
    Panel = Color3.fromRGB(30, 30, 36),
    Item = Color3.fromRGB(42, 42, 50),
    Text = Color3.fromRGB(225, 225, 230),
    Dim = Color3.fromRGB(140, 140, 150),
    Accent = Color3.fromRGB(0, 170, 255),
}
local accentObjects = {} -- {instance, property}

local function accent(inst, prop)
    table.insert(accentObjects, {inst, prop})
    inst[prop] = Theme.Accent
end

local function setAccent(c)
    Theme.Accent = c
    for _, a in ipairs(accentObjects) do
        if a[1] and a[1].Parent then a[1][a[2]] = c end
    end
end

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function corner(p, r) new("UICorner", {CornerRadius = UDim.new(0, r or 4)}, p) end

