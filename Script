local hudOpt = {coords = false, clock = false, session = false, players = false, memory = false, speed = false, compass = false}
local statsListeners = {}
local dirs = {"N", "NE", "E", "SE", "S", "SW", "W", "NW"}

local hudFrames, hudLast = 0, tick()
conn(RunService.RenderStepped, function()
    if not Alive then return end
    Camera = workspace.CurrentCamera
    if fovOn and Camera then Camera.FieldOfView = fovValue end
    hudFrames += 1
    local now = tick()
    if now - hudLast < 0.5 then return end
    local fps = math.floor(hudFrames / (now - hudLast) + 0.5)
    hudFrames, hudLast = 0, now
    local ping = 0
    pcall(function() ping = math.floor(LP:GetNetworkPing() * 2000) end)
    for _, f in ipairs(statsListeners) do pcall(f, fps, ping) end

    if hud.Visible then
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local t = {"FPS:  " .. fps, "Ping: " .. ping .. " ms"}
        if hudOpt.coords and hrp then
            local p = hrp.Position
            t[#t + 1] = string.format("XYZ: %d, %d, %d", math.floor(p.X), math.floor(p.Y), math.floor(p.Z))
        end
        if hudOpt.clock then t[#t + 1] = os.date("Time: %I:%M:%S %p") end
        if hudOpt.session then
            local s = math.floor(tick() - startTick)
            t[#t + 1] = string.format("Session: %02d:%02d:%02d", math.floor(s / 3600), math.floor((s % 3600) / 60), s % 60)
        end
        if hudOpt.players then t[#t + 1] = "Players: " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers end
        if hudOpt.memory then
            local mem = 0
            pcall(function() mem = math.floor(Stats:GetTotalMemoryUsageMb()) end)
            t[#t + 1] = "Memory: " .. mem .. " MB"
        end
        if hudOpt.speed and hrp then
            local v = hrp.AssemblyLinearVelocity
            t[#t + 1] = string.format("Speed: %.1f st/s", Vector3.new(v.X, 0, v.Z).Magnitude)
        end
        if hudOpt.compass and Camera then
            local look = Camera.CFrame.LookVector
            local yaw = (math.deg(math.atan2(look.X, -look.Z)) + 360) % 360
            t[#t + 1] = string.format("Facing: %s (%d)", dirs[math.floor((yaw + 22.5) / 45) % 8 + 1], math.floor(yaw))
        end
        hud.Size = UDim2.fromOffset(170, #t * 14 + 8)
        hud.Text = table.concat(t, "\n")
    end
end)

