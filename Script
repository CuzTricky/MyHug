-- ===== Extras tab =====
do
    local StarterGui = game:GetService("StarterGui")
    local L, R = addTab("Extras", "HUD & Crosshair", "Screen")

    -- draggable stats HUD
    local hud = new("TextLabel", {
        Size = UDim2.fromOffset(150, 58), Position = UDim2.new(0, 12, 0, 60), BackgroundColor3 = Theme.Bg,
        BackgroundTransparency = 0.2, BorderSizePixel = 0, Visible = false, TextColor3 = Theme.Text,
        Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top, Text = "",
    }, Gui)
    corner(hud, 4)
    new("UIPadding", {PaddingLeft = UDim.new(0, 6), PaddingTop = UDim.new(0, 4)}, hud)
    do
        local dragging, startPos, startInput
        hud.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging, startPos, startInput = true, hud.Position, i.Position
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - startInput
                hud.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
    end

    local showCoords, hudFrames, hudLast = false, 0, tick()
    RunService.RenderStepped:Connect(function()
        if not hud.Visible then return end
        hudFrames += 1
        if tick() - hudLast >= 0.5 then
            local fps = math.floor(hudFrames / (tick() - hudLast))
            hudFrames, hudLast = 0, tick()
            local ping = 0
            pcall(function() ping = math.floor(LP:GetNetworkPing() * 2000) end)
            local txt = "FPS:  " .. fps .. "\nPing: " .. ping .. " ms"
            if showCoords then
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local p = hrp.Position
                    txt = txt .. string.format("\nXYZ: %d, %d, %d", p.X, p.Y, p.Z)
                end
            end
            hud.Text = txt
            hud.Size = UDim2.fromOffset(150, showCoords and 58 or 42)
        end
    end)

    addToggle(L, "Stats HUD (draggable)", false, function(v) hud.Visible = v end)
    addToggle(L, "Show coordinates in HUD", false, function(v) showCoords = v end)

    -- crosshair overlay
    local cross = new("Frame", {Size = UDim2.fromOffset(40, 40), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Visible = false}, Gui)
    local hLine = new("Frame", {Size = UDim2.new(1, 0, 0, 2), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BorderSizePixel = 0}, cross)
    local vLine = new("Frame", {Size = UDim2.new(0, 2, 1, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BorderSizePixel = 0}, cross)
    accent(hLine, "BackgroundColor3")
    accent(vLine, "BackgroundColor3")
    addToggle(L, "Crosshair overlay", false, function(v) cross.Visible = v end)
    addSlider(L, "Crosshair size", 6, 60, 20, 2, "", function(v) cross.Size = UDim2.fromOffset(v * 2, v * 2) end)

    -- screen options
    local scale = new("UIScale", {Scale = 1}, Main)
    addSlider(R, "Menu scale", 70, 130, 100, 5, "%", function(v) scale.Scale = v / 100 end)
    addToggle(R, "Hide top MyHug button", false, function(v) OpenBtn.Visible = not v end)
    addToggle(R, "Hide chat", false, function(v)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, not v) end)
    end)
    addToggle(R, "Hide player list", false, function(v)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, not v) end)
    end)
    addButton(R, "Screenshot mode (hide UI 5s)", function()
        local menuWas, btnWas, hudWas, crossWas = Main.Visible, OpenBtn.Visible, hud.Visible, cross.Visible
        Main.Visible, OpenBtn.Visible, hud.Visible, cross.Visible = false, false, false, false
        task.wait(5)
        Main.Visible, OpenBtn.Visible, hud.Visible, cross.Visible = menuWas, btnWas, hudWas, crossWas
    end)
end

