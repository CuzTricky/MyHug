-- main loop
local acc = 0
conn(RunService.Heartbeat, function(dt)
    if not Alive then return end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if speedOn and hum then hum.WalkSpeed = speedValue end
    if jumpOn and hum then
        hum.UseJumpPower = true
        hum.JumpPower = jumpValue
    end
    if gravOn then workspace.Gravity = gravValue end
    if freezeOn then
        Lighting.ClockTime = frozenTime
    elseif cycleOn then
        Lighting.ClockTime = (Lighting.ClockTime + dt * 0.5) % 24
    end
    if rainbowOn then applyAccent(Color3.fromHSV((tick() * 0.2) % 1, 0.75, 1)) end
    acc += dt
    if acc >= 0.5 then
        acc = 0
        if hideChar and char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.LocalTransparencyModifier = 1 end
            end
        end
    end
end)

