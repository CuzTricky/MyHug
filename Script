local TabBar = new("Frame", {Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0, 8, 0, 34), BackgroundTransparency = 1}, Main)
new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4)}, TabBar)

local PageHolder = new("Frame", {Size = UDim2.new(1, -16, 1, -72), Position = UDim2.new(0, 8, 0, 64), BackgroundTransparency = 1}, Main)

local tabs = {}
local function selectTab(name)
    for n, t in pairs(tabs) do
        t.page.Visible = (n == name)
        t.btn.BackgroundColor3 = (n == name) and Theme.Item or Theme.Panel
    end
end

local function column(parent, xScale, title)
    local box = new("Frame", {
        Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new(xScale, xScale == 0 and 0 or 4, 0, 0),
        BackgroundColor3 = Theme.Panel, BorderSizePixel = 0,
    }, parent)
    corner(box, 4)
    new("TextLabel", {
        Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(8, 2), BackgroundTransparency = 1,
        Text = title, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Dim,
        Font = Enum.Font.GothamBold, TextSize = 11,
    }, box)
    local scroll = new("ScrollingFrame", {
        Size = UDim2.new(1, -10, 1, -26), Position = UDim2.fromOffset(5, 24), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 2, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, box)
    new("UIListLayout", {Padding = UDim.new(0, 5)}, scroll)
    return scroll
end

local function addTab(name, leftTitle, rightTitle)
    local btn = new("TextButton", {
        Size = UDim2.fromOffset(90, 26), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0,
        Text = name, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 12,
    }, TabBar)
    corner(btn, 4)
    local page = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false}, PageHolder)
    tabs[name] = {btn = btn, page = page}
    btn.MouseButton1Click:Connect(function() selectTab(name) end)
    return column(page, 0, leftTitle), column(page, 0.5, rightTitle)
end

-- ===== controls =====
local function addToggle(parent, text, default, cb)
    local state = default and true or false
    local row = new("TextButton", {Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = Theme.Item, BorderSizePixel = 0, Text = "", AutoButtonColor = false}, parent)
    corner(row, 3)
    local box = new("Frame", {Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(5, 4), BackgroundColor3 = Theme.Bg, BorderSizePixel = 0}, row)
    corner(box, 3)
    local fill = new("Frame", {Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(3, 3), BorderSizePixel = 0, Visible = state}, box)
    accent(fill, "BackgroundColor3")
    corner(fill, 2)
    new("TextLabel", {
        Size = UDim2.new(1, -28, 1, 0), Position = UDim2.fromOffset(26, 0), BackgroundTransparency = 1,
        Text = text, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 12,
    }, row)
    row.MouseButton1Click:Connect(function()
        state = not state
        fill.Visible = state
        task.spawn(cb, state)
    end)
    if state then task.spawn(cb, state) end
end

local function addSlider(parent, text, min, max, default, step, suffix, cb)
    local frame = new("Frame", {Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Theme.Item, BorderSizePixel = 0}, parent)
    corner(frame, 3)
    local label = new("TextLabel", {
        Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(6, 1), BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 12, Text = "",
    }, frame)
    local bar = new("Frame", {Size = UDim2.new(1, -12, 0, 6), Position = UDim2.fromOffset(6, 22), BackgroundColor3 = Theme.Bg, BorderSizePixel = 0}, frame)
    corner(bar, 3)
    local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0}, bar)
    accent(fill, "BackgroundColor3")
    corner(fill, 3)

    local value = default
    local function set(v)
        v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
        value = v
        fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
        label.Text = text .. ": " .. tostring(v) .. (suffix or "")
        cb(v)
    end
    set(default)

    local dragging = false
    local function fromInput(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        set(min + (max - min) * rel)
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromInput(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            fromInput(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

