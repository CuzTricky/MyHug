local function addSwatches(parent, text, colors, cb)
    local frame = new("Frame", {Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = Theme.Item, BorderSizePixel = 0}, parent)
    corner(frame, 3)
    new("TextLabel", {
        Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(6, 1), BackgroundTransparency = 1,
        Text = text, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 12,
    }, frame)
    local row = new("Frame", {Size = UDim2.new(1, -12, 0, 18), Position = UDim2.fromOffset(6, 22), BackgroundTransparency = 1}, frame)
    new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5)}, row)
    for _, c in ipairs(colors) do
        local s = new("TextButton", {Size = UDim2.fromOffset(28, 18), BackgroundColor3 = c, BorderSizePixel = 0, Text = ""}, row)
        corner(s, 3)
        s.MouseButton1Click:Connect(function() cb(c) end)
    end
end

local function addLabel(parent, text)
