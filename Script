local restoreAll
do
    local L, R = addTab("Settings", "Appearance", "Menu & Config")

    local function setAccentRGB(s)
        local r, g, b = tostring(s):match("(%d+),(%d+),(%d+)")
        if r then
            local c = Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
            baseAccent = c
            Flags.accent = s
            if not rainbowOn then applyAccent(c) end
        end
    end
    local swatchColors = {
        Color3.fromRGB(0, 170, 255), Color3.fromRGB(170, 85, 255), Color3.fromRGB(255, 85, 120),
        Color3.fromRGB(70, 220, 120), Color3.fromRGB(255, 170, 40),
    }
    addSwatches(L, "Accent color", swatchColors, function(c)
        setAccentRGB(string.format("%d,%d,%d", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)))
    end)
    Flags.accent, Defaults.accent, Setters.accent = "0,170,255", "0,170,255", setAccentRGB

    addToggle(L, "Rainbow accent", false, function(v)
        rainbowOn = v
        if not v then applyAccent(baseAccent) end
    end, "rainbow")

    local themeBtn
    local themed = {}
    local function applyTheme(name)
        local t = Themes[name]
        if not t then return end
        currentTheme = name
        Flags.theme = name
        Theme.Bg, Theme.Panel, Theme.Item = t.Bg, t.Panel, t.Item
        for _, e in ipairs(themed) do
            if e[1] and e[1].Parent then e[1].BackgroundColor3 = Theme[e[2]] end
        end
        selectTab(currentTab)
        if themeBtn then themeBtn.Text = "Theme: " .. name end
    end
    themeBtn = addButton(L, "Theme: Dark", function()
        for i, n in ipairs(ThemeOrder) do
            if n == currentTheme then
                applyTheme(ThemeOrder[i % #ThemeOrder + 1])
                return
            end
        end
    end)
    Flags.theme, Defaults.theme, Setters.theme = "Dark", "Dark", applyTheme

    addSlider(L, "Menu transparency", 0, 50, 0, 5, "%", function(v) Main.BackgroundTransparency = v / 100 end, "menutrans")
    addToggle(L, "Lock menu position", false, function(v) dragLocked = v end, "lockpos")

    -- menu keybind
    local keyBtn
    local keys = {"RightShift", "Insert", "RightControl", "Home", "K"}
    local function setKey(n)
        local kc = Enum.KeyCode[tostring(n)]
        if kc then
            menuKey = kc
            Flags.keybind = tostring(n)
            if keyBtn then keyBtn.Text = "Menu key: " .. tostring(n) end
        end
    end
    keyBtn = addButton(R, "Menu key: RightShift", function()
        for i, n in ipairs(keys) do
            if Enum.KeyCode[n] == menuKey then
                setKey(keys[i % #keys + 1])
                return
            end
        end
        setKey(keys[1])
    end)
    Flags.keybind, Defaults.keybind, Setters.keybind = "RightShift", "RightShift", setKey

    addButton(R, "Save settings", function()
        if not writefile then return notify("Executor can't save files") end
        local ok = pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(Flags)) end)
        notify(ok and "Settings saved" or "Save failed")
    end)
    addButton(R, "Load settings", function()
        if not (readfile and isfile and isfile(CONFIG_FILE)) then return notify("No saved settings") end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
        if ok and type(data) == "table" then
            for k, v in pairs(data) do
                if Setters[k] then pcall(Setters[k], v) end
            end
            notify("Settings loaded")
        else
            notify("Load failed")
        end
    end)
    addButton(R, "Reset all settings", function()
        for k, s in pairs(Setters) do
            if Defaults[k] ~= nil then pcall(s, Defaults[k]) end
        end
        notify("All settings reset")
    end)

    restoreAll = function()
        Alive = false
        for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
        for k, val in pairs(origLighting) do Lighting[k] = val end
        workspace.Gravity = origGravity
        pcall(function()
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
        end)
        pcall(function()
            if muted then UserSettings():GetService("UserGameSettings").MasterVolume = lastVolume or 1 end
        end)
        pcall(function() LP.CameraMode = Enum.CameraMode.Classic end)
        if fovOn and Camera then Camera.FieldOfView = 70 end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and speedOn then hum.WalkSpeed = 16 end
        if hum and jumpOn then hum.JumpPower = 50 end
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.LocalTransparencyModifier = 0 end
            end
        end
        for _, d in ipairs(hiddenFx) do if d.Parent then d.Enabled = true end end
        for _, e in ipairs({CC, Bloom, Blur, Rays}) do e:Destroy() end
        Gui:Destroy()
    end
    addButton(R, "Destroy MyHug", function() restoreAll() end)

    -- register themed backgrounds (everything built so far plus HUD/toasts)
    task.defer(function()
        for _, d in ipairs(Gui:GetDescendants()) do
            if d:IsA("GuiObject") then
                for _, slot in ipairs({"Bg", "Panel", "Item"}) do
                    if d.BackgroundColor3 == Themes.Dark[slot] then
                        table.insert(themed, {d, slot})
                        break
                    end
                end
            end
        end
    end)
end

selectTab("Visuals")
task.defer(function() Ready = true end)
notify("MyHug v" .. VERSION .. " loaded")
